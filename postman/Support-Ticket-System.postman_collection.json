{
  "info": {
    "name": "Support Ticket System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API collection for the Support Ticket Management System"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "customerToken", "value": "" },
    { "key": "agentToken", "value": "" },
    { "key": "ticketId", "value": "1" },
    { "key": "otherTicketId", "value": "2" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status ok', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register customer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('created', function () { pm.response.to.have.status(201); });", "const json = pm.response.json();", "if (json.data && json.data.token) { pm.collectionVariables.set('customerToken', json.data.token); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman.customer@example.com\",\n  \"password\": \"Password123\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login customer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('login 200', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "pm.collectionVariables.set('customerToken', json.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login agent",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('login 200', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "pm.collectionVariables.set('agentToken', json.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"agent1@example.com\",\n  \"password\": \"Password123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Invalid login",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('unauthorized', function () { pm.response.to.have.status(401); });"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "TICKETS",
      "item": [
        {
          "name": "Create ticket",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('ticketId', String(pm.response.json().data.id));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Printer not working\",\n  \"description\": \"The office printer shows an error code.\",\n  \"priority\": \"medium\"\n}" },
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "Get tickets",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets?search=printer&status=open&priority=medium&sortBy=created_at&sortOrder=DESC"
          }
        },
        {
          "name": "Get ticket by ID",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Update ticket",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"assigned_to\": 2\n}" },
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Delete ticket",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok or forbidden', function () { pm.expect([200, 403]).to.include(pm.response.code); });"] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        }
      ]
    },
    {
      "name": "COMMENTS",
      "item": [
        {
          "name": "Get comments",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok or not found', function () { pm.expect([200, 404]).to.include(pm.response.code); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "Add comment",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('created or missing', function () { pm.expect([201, 404]).to.include(pm.response.code); });"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Please look into this today.\"\n}" },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        }
      ]
    },
    {
      "name": "USERS",
      "item": [
        {
          "name": "Get agents/users",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },
    {
      "name": "SECURITY",
      "item": [
        {
          "name": "Missing token",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', function () { pm.response.to.have.status(401); });"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/tickets" }
        },
        {
          "name": "Wrong role",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403', function () { pm.response.to.have.status(403); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Customer accessing another customer ticket",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 or 404', function () { pm.expect([403, 404]).to.include(pm.response.code); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets/{{otherTicketId}}"
          }
        },
        {
          "name": "Invalid input",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', function () { pm.response.to.have.status(400); });"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"\",\n  \"description\": \"\",\n  \"priority\": \"urgent\"\n}" },
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "Nonexistent ticket",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', function () { pm.response.to.have.status(404); });"] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": "{{baseUrl}}/tickets/999999"
          }
        }
      ]
    }
  ]
}
