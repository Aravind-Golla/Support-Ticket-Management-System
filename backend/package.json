{
  "name": "support-ticket-backend",
  "version": "1.0.0",
  "description": "Support Ticket Management System API",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "seed:passwords": "node scripts/generateSeedHashes.js"
  },
  "keywords": [
    "tickets",
    "support",
    "express",
    "mysql"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
